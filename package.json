{
  "name": "mywebview",
  "version": "1.3.0-beta.1",
  "description": "プレゼン用 webview",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win dir --x64 && sh scripts/package-win.sh"
  },
  "build": {
    "appId": "jp.local.mywebview",
    "productName": "mywebview",
    "files": [
      "main.js",
      "exe.js",
      "preload.js",
      "panel/**",
      "package.json",
      "!node_modules/@koromix/**",
      "!node_modules/koffi/{doc,lib,vendor}/**",
      "!node_modules/koffi/src/koffi/src/**/*.{cc,hh,inc,S,asm,def}"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir"
    }
  },
  "keywords": [],
  "author": "KONISHI Yasuhiro",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  }
}
